<script>
(()=>{
  "use strict";

  const destinations = [
    {
      id:"harmony",
      category:"create",
      section:"Create & Record",
      featured:true,
      tone:"gold",
      icon:"♬",
      title:"Harmony’s Haven Studio™",
      subtitle:"88-Key Multi-Track Music Studio · Hosted at ProReSources",
      description:"Play a full piano keyboard, compare instruments, practice scales, record layered tracks, view notation, play arrangements, print staff work, and export project data.",
      features:["88-key playable keyboard","Multi-track recorder and mix playback","Scale practice and staff notation"],
      href:"https://vervenveda.github.io/proresource_hub.github.io/Protools/Harmony%27s%20Haven%20Studio%E2%84%A2%20Multi-Track_index.html",
      action:"Open Music Studio",
      status:"live"
    },
    {
      id:"fleapit",
      category:"create",
      section:"Create & Record",
      tone:"teal",
      icon:"▶",
      title:"FleaPit™ Media Hub",
      subtitle:"Music Video & Media Discovery · Hosted at ProReSources",
      description:"Gather music videos, performances, public archives, lectures, and direct media into a private browser-based library.",
      href:"https://vervenveda.github.io/proresource_hub.github.io/Protools/FleaPit%E2%84%A2_media_hub_Index.html",
      action:"Open Media Hub",
      status:"live"
    },
    {
      id:"arshif",
      category:"learn",
      section:"Learn & Research",
      tone:"violet",
      icon:"⌘",
      title:"ARSHIF Music Knowledge",
      subtitle:"History · Theory · Instruments · Archives",
      description:"Enter the wider ARSHIF research environment for music history, cultural context, composers, instruments, scholarship, and source-based study.",
      href:"https://vervenveda.github.io/Arshif.github.io/",
      action:"Open ARSHIF",
      status:"live"
    },
    {
      id:"academy",
      category:"learn",
      section:"Learn & Research",
      tone:"teal",
      icon:"◇",
      title:"Khaemenes Academy",
      subtitle:"Music Learning Across Ages",
      description:"Connect learners to age-appropriate music study, creative practice, classroom projects, and future Academy music courses.",
      href:"https://vervenveda.github.io/khaemenesacademy.github.io/",
      action:"Open the Academy",
      status:"live"
    },
    {
      id:"prose",
      category:"share",
      section:"Share & Publish",
      tone:"violet",
      icon:"¶",
      title:"PROSE™ Editorial Suite",
      subtitle:"Lyrics · Artist Bios · Liner Notes · Proposals",
      description:"Write and refine lyrics, biographies, liner notes, press materials, grant applications, teaching notes, and publication-ready music writing.",
      href:"https://vervenveda.github.io/proresource_hub.github.io/Protools/PROSE%E2%84%A2%20editingsuite_index.html",
      action:"Open PROSE",
      status:"live"
    },
    {
      id:"bazaar-live",
      category:"share",
      section:"Share & Publish",
      tone:"rose",
      icon:"✦",
      title:"Bazaar Art Live",
      subtitle:"333 Creative Community Feed · Hosted at ProReSources",
      description:"Share music, studio notes, events, reels, collaborations, and creative announcements with an optional community feed.",
      href:"https://vervenveda.github.io/proresource_hub.github.io/Protools/Bazaar%20Art%20Live%20333%20Social%20Feed_index.html",
      action:"Open Bazaar Art Live",
      status:"live"
    },
    {
      id:"bazaar-art",
      category:"share",
      section:"Share & Publish",
      tone:"gold",
      icon:"▧",
      title:"Bazaar Art",
      subtitle:"Creative Community & Opportunity Hub",
      description:"Connect music-making to the broader Bazaar Art ecosystem of artists, opportunities, public work, portfolios, and creative enterprise.",
      href:"https://vervenveda.github.io/bazaarart.github.io/",
      action:"Open Bazaar Art",
      status:"live"
    },
    {
      id:"gallery",
      category:"share",
      section:"Share & Publish",
      tone:"violet",
      icon:"▣",
      title:"My Art Gallery",
      subtitle:"Portfolio & Creative Presentation",
      description:"Present visual identity, album artwork, performance photography, project documentation, and interdisciplinary portfolios.",
      href:"https://vervenveda.github.io/myartgallery.github.io/",
      action:"Open Gallery",
      status:"live"
    },
    {
      id:"aurora",
      category:"reflect",
      section:"Reflect & Restore",
      tone:"teal",
      icon:"◌",
      title:"The Aurora Sanctuary",
      subtitle:"Reflection · Renewal · Creative Quiet",
      description:"A restorative space for reflection, creative renewal, quiet practice, intentional listening, and returning to the work with clarity.",
      href:"https://vervenveda.github.io/aurora.github.io/",
      action:"Enter the Sanctuary",
      status:"live"
    },
    {
      id:"verve",
      category:"reflect",
      section:"Reflect & Restore",
      tone:"gold",
      icon:"V",
      title:"Verve N Veda",
      subtitle:"The Public Gateway",
      description:"Return to the complete Verve N Veda matrix to explore connected learning, research, civic, health, creative, and professional spaces.",
      href:"https://vervenveda.github.io/",
      action:"Open Verve N Veda",
      status:"live"
    }
  ];

  const planned = [
    {title:"VENUS™",description:"A professional musicians’ social space for profiles, gigs, collaboration, and opportunity."},
    {title:"GamutStudio™",description:"A synchronized music and video production studio for arranging multimedia work."},
    {title:"Gamut Engine™",description:"A deeper audio-visual engine for timing, sequencing, rendering, and export."},
    {title:"Song Embedder",description:"A focused tool for presenting songs, credits, lyrics, context, and shareable media."},
    {title:"Ear Training Lab",description:"Intervals, pitch recognition, rhythm, chords, and progressive listening practice."},
    {title:"Songwriting Room",description:"Structure, rhyme, melody notes, drafts, revisions, and version history."},
    {title:"Performance Planner",description:"Rehearsal plans, set lists, stage notes, equipment, schedules, and run-of-show tools."},
    {title:"Music Rights Desk",description:"Credits, splits, registrations, release records, permissions, and rights education."}
  ];

  const root = document.getElementById("directoryRoot");
  const plannedGrid = document.getElementById("plannedGrid");
  const search = document.getElementById("hubSearch");
  const clearSearch = document.getElementById("clearSearch");
  const tabs = Array.from(document.querySelectorAll(".category-tab"));
  const menuButton = document.getElementById("menuButton");
  const topNavigation = document.getElementById("topNavigation");
  let activeCategory = "all";

  function cardHTML(item){
    const toneClass = item.tone === "teal" ? "teal-card" : item.tone === "violet" ? "violet-card" : item.tone === "rose" ? "rose-card" : "";
    return `<article class="hub-card ${item.featured ? "featured" : ""} ${toneClass}" data-category="${item.category}">
      <div class="card-top">
        <div class="card-icon" aria-hidden="true">${item.icon}</div>
        <span class="status live">Connected</span>
      </div>
      <h3>${item.title}</h3>
      <div class="card-sub">${item.subtitle}</div>
      <p>${item.description}</p>
      ${item.features ? `<ul class="feature-list">${item.features.map(feature=>`<li>${feature}</li>`).join("")}</ul>` : ""}
      <div class="card-actions">
        <a class="button ${item.featured ? "primary" : ""}" href="${item.href}">${item.action}</a>
      </div>
    </article>`;
  }

  function render(){
    const query = search.value.trim().toLowerCase();
    const filtered = destinations.filter(item=>{
      const categoryMatch = activeCategory === "all" || item.category === activeCategory;
      const haystack = [item.title,item.subtitle,item.description,item.section,...(item.features||[])].join(" ").toLowerCase();
      return categoryMatch && (!query || haystack.includes(query));
    });

    const sections = [
      ["create","Create & Record","Studios and media tools for playing, arranging, recording, practicing, and preserving sound."],
      ["learn","Learn & Research","Music knowledge across scholarship, history, theory, classroom study, and cultural context."],
      ["share","Share & Publish","Tools for writing, presentation, portfolios, community participation, and creative opportunity."],
      ["reflect","Reflect & Restore","Spaces for intentional listening, reflection, renewal, and returning to the work."]
    ];

    const visibleSections = sections.filter(([key])=>filtered.some(item=>item.category===key));
    if(!visibleSections.length){
      root.innerHTML = `<div class="empty-state">No music destinations match that search.</div>`;
      return;
    }

    root.innerHTML = visibleSections.map(([key,title,description])=>{
      const cards = filtered.filter(item=>item.category===key);
      return `<section class="hub-section" id="${key}">
        <div class="section-head">
          <div><div class="section-kicker">${title}</div><h2>${title}</h2></div>
          <p>${description}</p>
        </div>
        <div class="card-grid">${cards.map(cardHTML).join("")}</div>
      </section>`;
    }).join("");
  }

  function renderPlanned(){
    plannedGrid.innerHTML = planned.map(item=>`<article class="planned-item">
      <span aria-hidden="true">⌁</span>
      <h3>${item.title}</h3>
      <p>${item.description}</p>
    </article>`).join("");
    document.getElementById("liveCount").textContent = destinations.length;
    document.getElementById("plannedCount").textContent = planned.length;
  }

  tabs.forEach((tab,index)=>{
    tab.addEventListener("click",()=>{
      activeCategory = tab.dataset.category;
      tabs.forEach(button=>button.setAttribute("aria-selected",String(button===tab)));
      render();
    });
    tab.addEventListener("keydown",event=>{
      if(!["ArrowLeft","ArrowRight","Home","End"].includes(event.key)) return;
      event.preventDefault();
      let next=index;
      if(event.key==="ArrowRight") next=(index+1)%tabs.length;
      if(event.key==="ArrowLeft") next=(index-1+tabs.length)%tabs.length;
      if(event.key==="Home") next=0;
      if(event.key==="End") next=tabs.length-1;
      tabs[next].focus();
      tabs[next].click();
    });
  });

  search.addEventListener("input",render);
  clearSearch.addEventListener("click",()=>{
    search.value="";
    search.focus();
    render();
  });

  menuButton.addEventListener("click",()=>{
    const open = topNavigation.classList.toggle("open");
    menuButton.setAttribute("aria-expanded",String(open));
  });

  topNavigation.addEventListener("click",event=>{
    if(event.target.closest("a")){
      topNavigation.classList.remove("open");
      menuButton.setAttribute("aria-expanded","false");
    }
  });

  document.addEventListener("keydown",event=>{
    if(event.key==="Escape" && topNavigation.classList.contains("open")){
      topNavigation.classList.remove("open");
      menuButton.setAttribute("aria-expanded","false");
      menuButton.focus();
    }
  });

  render();
  renderPlanned();
})();
</script>
</body>
</html>
