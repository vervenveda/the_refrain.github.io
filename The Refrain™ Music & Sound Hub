<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="The Refrain™ — a professional music and sound hub connecting creation, recording, learning, research, publishing, performance, and reflection across Verve N Veda.">
  <meta name="theme-color" content="#101426">
  <meta name="color-scheme" content="dark light">
  <title>The Refrain™ — Music & Sound Hub</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Aboreto&family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --font-display:"Gaspacho","Cormorant Garamond",Georgia,serif;
      --font-brand:"Cinzel","Aboreto",Georgia,serif;
      --font-ui:"Brandon Grotesque","Montserrat",system-ui,-apple-system,"Segoe UI",sans-serif;

      --night:#0c1020;
      --night-2:#151b32;
      --night-3:#1e2745;
      --paper:#f8f4ea;
      --paper-2:#eee6d7;
      --ink:#f7f4ed;
      --muted:#b7b8c4;
      --faint:#83889e;
      --gold:#d5b56f;
      --gold-2:#f0d898;
      --teal:#79c8bf;
      --violet:#9d8dd8;
      --rose:#c785a4;
      --line:rgba(232,213,168,.18);
      --line-soft:rgba(255,255,255,.09);
      --panel:rgba(22,28,50,.84);
      --panel-2:rgba(29,37,66,.86);
      --shadow:0 22px 70px rgba(0,0,0,.32);
      --radius:20px;
      --max:1240px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      min-height:100vh;
      color:var(--ink);
      background:
        radial-gradient(circle at 12% -4%,rgba(213,181,111,.18),transparent 33rem),
        radial-gradient(circle at 92% 7%,rgba(121,200,191,.13),transparent 31rem),
        radial-gradient(circle at 52% 100%,rgba(157,141,216,.10),transparent 40rem),
        linear-gradient(145deg,var(--night),#090d19 72%);
      font-family:var(--font-ui);
      letter-spacing:.004em;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      opacity:.26;
      background:
        linear-gradient(transparent 95%,rgba(240,216,152,.18) 96%,transparent 97%);
      background-size:100% 28px;
      mask-image:linear-gradient(to bottom,#000,transparent 78%);
    }

    a{color:inherit;text-decoration:none}
    button,input{font:inherit}
    button{cursor:pointer}
    [hidden]{display:none!important}
    :focus-visible{outline:3px solid rgba(121,200,191,.72);outline-offset:3px}

    .skip-link{
      position:fixed;
      left:12px;
      top:-80px;
      z-index:1000;
      background:var(--paper);
      color:#15182a;
      padding:10px 14px;
      border-radius:9px;
    }
    .skip-link:focus{top:12px}

    .topbar{
      position:sticky;
      top:0;
      z-index:50;
      border-bottom:1px solid var(--line);
      background:rgba(10,14,27,.86);
      backdrop-filter:blur(18px);
    }

    .topbar-inner{
      width:min(var(--max),calc(100% - 32px));
      min-height:68px;
      margin:auto;
      display:flex;
      align-items:center;
      gap:18px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:11px;
      min-width:0;
    }

    .brand-mark{
      width:42px;
      height:42px;
      border:1px solid rgba(240,216,152,.48);
      border-radius:13px;
      display:grid;
      place-items:center;
      background:
        radial-gradient(circle at 34% 26%,rgba(255,255,255,.14),transparent 35%),
        linear-gradient(145deg,rgba(213,181,111,.20),rgba(121,200,191,.10));
      color:var(--gold-2);
      font-family:var(--font-brand);
      font-size:.72rem;
      font-weight:600;
      letter-spacing:.08em;
    }

    .brand-copy strong{
      display:block;
      font-family:var(--font-brand);
      font-size:.78rem;
      font-weight:600;
      letter-spacing:.13em;
      text-transform:uppercase;
    }

    .brand-copy span{
      display:block;
      margin-top:2px;
      color:var(--muted);
      font-size:.67rem;
    }

    .topnav{
      margin-left:auto;
      display:flex;
      align-items:center;
      gap:5px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .topnav a,.menu-button{
      border:1px solid transparent;
      border-radius:8px;
      padding:8px 10px;
      background:transparent;
      color:#d8dbea;
      font-size:.68rem;
      font-weight:600;
    }

    .topnav a:hover,.menu-button:hover{
      border-color:var(--line);
      background:rgba(255,255,255,.045);
    }

    .menu-button{display:none}

    .hero{
      position:relative;
      overflow:hidden;
      border-bottom:1px solid var(--line);
    }

    .hero-inner{
      width:min(var(--max),calc(100% - 32px));
      min-height:590px;
      margin:auto;
      padding:72px 0 76px;
      display:grid;
      grid-template-columns:minmax(0,1.12fr) minmax(340px,.88fr);
      gap:58px;
      align-items:center;
    }

    .eyebrow,.section-kicker{
      color:var(--gold-2);
      font-family:var(--font-brand);
      font-size:.62rem;
      font-weight:600;
      letter-spacing:.22em;
      text-transform:uppercase;
    }

    h1,h2,h3{
      font-family:var(--font-display);
      font-weight:600;
    }

    h1{
      margin:13px 0 18px;
      font-size:clamp(3.5rem,8vw,7.4rem);
      line-height:.84;
      letter-spacing:-.035em;
    }

    h1 span{
      display:block;
      margin-top:14px;
      color:var(--gold-2);
      font-family:var(--font-brand);
      font-size:.17em;
      line-height:1.4;
      letter-spacing:.19em;
      text-transform:uppercase;
    }

    .hero-copy{
      max-width:720px;
      margin:0;
      color:#d0d4e2;
      font-size:clamp(.98rem,1.7vw,1.14rem);
      line-height:1.78;
    }

    .hero-actions{
      display:flex;
      gap:9px;
      flex-wrap:wrap;
      margin-top:27px;
    }

    .button{
      min-height:44px;
      border:1px solid var(--line);
      border-radius:9px;
      padding:10px 15px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      background:rgba(255,255,255,.055);
      color:var(--ink);
      font-size:.72rem;
      font-weight:650;
      transition:transform .16s ease,background .16s ease,border-color .16s ease;
    }

    .button:hover{
      transform:translateY(-2px);
      border-color:rgba(240,216,152,.50);
      background:rgba(255,255,255,.08);
    }

    .button.primary{
      border:0;
      color:#17140d;
      background:linear-gradient(135deg,var(--gold-2),#c79b4b);
      box-shadow:0 13px 34px rgba(0,0,0,.25);
    }

    .button.teal{
      border:0;
      color:#071716;
      background:linear-gradient(135deg,#9be0d7,#5eaca5);
    }

    .button.disabled{
      cursor:default;
      opacity:.7;
      color:var(--muted);
      background:rgba(255,255,255,.035);
    }

    .button.disabled:hover{transform:none}

    .sound-orbit{
      position:relative;
      min-height:410px;
      display:grid;
      place-items:center;
    }

    .record{
      position:relative;
      z-index:3;
      width:238px;
      height:238px;
      border-radius:50%;
      border:1px solid rgba(240,216,152,.58);
      display:grid;
      place-items:center;
      background:
        repeating-radial-gradient(circle,rgba(255,255,255,.035) 0 2px,transparent 3px 9px),
        radial-gradient(circle at 38% 28%,#2f385c,#0b0e19 64%);
      box-shadow:
        0 0 0 12px rgba(213,181,111,.03),
        0 35px 90px rgba(0,0,0,.5),
        inset 0 0 45px rgba(213,181,111,.12);
    }

    .record-core{
      width:94px;
      height:94px;
      border-radius:50%;
      display:grid;
      place-items:center;
      background:linear-gradient(145deg,var(--gold),var(--teal));
      color:#101426;
      font-family:var(--font-brand);
      font-size:.7rem;
      font-weight:700;
      letter-spacing:.11em;
      text-align:center;
      line-height:1.5;
      box-shadow:0 12px 34px rgba(0,0,0,.36);
    }

    .orbit-ring{
      position:absolute;
      border:1px solid rgba(240,216,152,.20);
      border-radius:50%;
    }

    .orbit-ring.one{width:370px;height:370px}
    .orbit-ring.two{width:305px;height:305px;border-color:rgba(121,200,191,.18)}
    .orbit-ring.three{width:465px;height:465px;border-style:dashed;opacity:.68}

    .orbit-label{
      position:absolute;
      z-index:4;
      width:155px;
      padding:11px 12px;
      border:1px solid var(--line);
      border-radius:12px;
      background:rgba(14,19,36,.86);
      box-shadow:0 12px 34px rgba(0,0,0,.24);
      backdrop-filter:blur(12px);
    }

    .orbit-label strong{
      display:block;
      font-family:var(--font-display);
      font-size:1rem;
      font-weight:600;
    }

    .orbit-label span{
      display:block;
      margin-top:3px;
      color:var(--muted);
      font-size:.62rem;
      line-height:1.45;
    }

    .orbit-label.a{left:0;top:38px}
    .orbit-label.b{right:-2px;top:92px}
    .orbit-label.c{left:18px;bottom:40px}
    .orbit-label.d{right:10px;bottom:34px}

    main{
      width:min(var(--max),calc(100% - 32px));
      margin:auto;
      padding:64px 0 82px;
    }

    .intro-band{
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:22px;
      align-items:center;
      margin-bottom:52px;
      padding:22px 24px;
      border:1px solid var(--line);
      border-radius:var(--radius);
      background:
        radial-gradient(circle at 100% 0%,rgba(121,200,191,.09),transparent 24rem),
        var(--panel);
      box-shadow:var(--shadow);
    }

    .intro-band h2{
      margin:5px 0 7px;
      font-size:clamp(1.9rem,4vw,2.7rem);
      line-height:1;
    }

    .intro-band p{
      max-width:760px;
      margin:0;
      color:var(--muted);
      font-size:.8rem;
      line-height:1.7;
    }

    .hub-count{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:7px;
      min-width:190px;
    }

    .count-card{
      border:1px solid var(--line-soft);
      border-radius:11px;
      padding:11px;
      background:rgba(255,255,255,.035);
    }

    .count-card strong{
      display:block;
      font-family:var(--font-display);
      font-size:1.45rem;
    }

    .count-card span{
      color:var(--muted);
      font-size:.61rem;
    }

    .directory-tools{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      margin-bottom:18px;
      flex-wrap:wrap;
    }

    .directory-tools h2{
      margin:4px 0 0;
      font-size:clamp(2.15rem,4.5vw,3.35rem);
      line-height:.98;
    }

    .search{
      width:min(390px,100%);
      display:flex;
      gap:7px;
      padding:6px;
      border:1px solid var(--line);
      border-radius:11px;
      background:var(--panel);
    }

    .search input{
      min-width:0;
      flex:1;
      border:0;
      outline:0;
      padding:8px 10px;
      background:transparent;
      color:var(--ink);
      font-size:.72rem;
    }

    .search button{
      border:0;
      border-radius:8px;
      padding:8px 10px;
      background:var(--night-3);
      color:var(--muted);
      font-size:.68rem;
      font-weight:650;
    }

    .category-tabs{
      display:flex;
      gap:6px;
      margin-bottom:22px;
      overflow:auto;
      scrollbar-width:none;
    }

    .category-tabs::-webkit-scrollbar{display:none}

    .category-tab{
      flex:0 0 auto;
      border:1px solid var(--line);
      border-radius:8px;
      padding:8px 11px;
      background:var(--panel);
      color:var(--muted);
      font-size:.66rem;
      font-weight:600;
    }

    .category-tab[aria-selected="true"]{
      border-color:var(--gold);
      background:var(--gold);
      color:#17140c;
    }

    .hub-section{
      margin-top:42px;
    }

    .hub-section:first-of-type{margin-top:0}

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:end;
      gap:24px;
      margin-bottom:15px;
    }

    .section-head h2{
      margin:5px 0 0;
      font-size:clamp(1.8rem,3.5vw,2.55rem);
      line-height:1;
    }

    .section-head p{
      max-width:520px;
      margin:0;
      color:var(--muted);
      font-size:.75rem;
      line-height:1.62;
    }

    .card-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:13px;
    }

    .hub-card{
      min-height:285px;
      padding:20px;
      border:1px solid var(--line);
      border-radius:17px;
      display:flex;
      flex-direction:column;
      background:
        radial-gradient(circle at 100% 100%,var(--glow,rgba(213,181,111,.08)),transparent 18rem),
        var(--panel);
      box-shadow:0 15px 42px rgba(0,0,0,.18);
      transition:transform .17s ease,border-color .17s ease;
    }

    .hub-card:hover{
      transform:translateY(-3px);
      border-color:rgba(240,216,152,.42);
    }

    .hub-card.featured{
      grid-column:span 2;
      min-height:325px;
      background:
        radial-gradient(circle at 90% 15%,rgba(213,181,111,.16),transparent 23rem),
        linear-gradient(145deg,rgba(35,42,72,.96),rgba(17,22,41,.96));
    }

    .hub-card.teal-card{--glow:rgba(121,200,191,.12)}
    .hub-card.violet-card{--glow:rgba(157,141,216,.12)}
    .hub-card.rose-card{--glow:rgba(199,133,164,.10)}

    .card-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
    }

    .card-icon{
      width:48px;
      height:48px;
      border:1px solid var(--line);
      border-radius:14px;
      display:grid;
      place-items:center;
      background:rgba(255,255,255,.045);
      color:var(--gold-2);
      font-size:1.3rem;
    }

    .status{
      border:1px solid var(--line);
      border-radius:8px;
      padding:6px 8px;
      color:var(--muted);
      background:rgba(255,255,255,.035);
      font-family:var(--font-brand);
      font-size:.53rem;
      font-weight:600;
      letter-spacing:.11em;
      text-transform:uppercase;
    }

    .status.live{
      color:#9fe2d7;
      border-color:rgba(121,200,191,.30);
      background:rgba(121,200,191,.07);
    }

    .status.planned{
      color:#e7ce90;
      border-color:rgba(213,181,111,.28);
      background:rgba(213,181,111,.07);
    }

    .hub-card h3{
      margin:20px 0 5px;
      font-size:1.62rem;
      line-height:1;
    }

    .hub-card.featured h3{font-size:2.15rem}

    .card-sub{
      color:var(--gold-2);
      font-family:var(--font-brand);
      font-size:.56rem;
      font-weight:600;
      letter-spacing:.15em;
      text-transform:uppercase;
    }

    .hub-card p{
      margin:14px 0 0;
      color:var(--muted);
      font-size:.74rem;
      line-height:1.67;
    }

    .feature-list{
      margin:15px 0 0;
      padding:0;
      list-style:none;
      display:grid;
      gap:7px;
      color:#d8d9e2;
      font-size:.68rem;
      line-height:1.45;
    }

    .feature-list li{
      display:flex;
      gap:8px;
    }

    .feature-list li::before{
      content:"♪";
      color:var(--teal);
    }

    .card-actions{
      display:flex;
      gap:7px;
      flex-wrap:wrap;
      margin-top:auto;
      padding-top:20px;
    }

    .planned-zone{
      margin-top:52px;
      padding:25px;
      border:1px dashed rgba(240,216,152,.28);
      border-radius:var(--radius);
      background:rgba(255,255,255,.025);
    }

    .planned-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:9px;
      margin-top:17px;
    }

    .planned-item{
      min-height:135px;
      padding:14px;
      border:1px solid var(--line-soft);
      border-radius:12px;
      background:rgba(255,255,255,.025);
    }

    .planned-item span{
      color:var(--gold-2);
      font-size:1rem;
    }

    .planned-item h3{
      margin:11px 0 5px;
      font-size:1.05rem;
    }

    .planned-item p{
      margin:0;
      color:var(--muted);
      font-size:.64rem;
      line-height:1.5;
    }

    .closing{
      margin-top:52px;
      padding:31px;
      border:1px solid var(--line);
      border-radius:var(--radius);
      text-align:center;
      background:
        radial-gradient(circle at 50% 0%,rgba(213,181,111,.11),transparent 25rem),
        var(--panel);
      box-shadow:var(--shadow);
    }

    .closing h2{
      margin:7px 0 10px;
      font-size:clamp(2rem,5vw,3.4rem);
    }

    .closing p{
      max-width:760px;
      margin:0 auto;
      color:var(--muted);
      font-size:.79rem;
      line-height:1.72;
    }

    .closing .hero-actions{justify-content:center}

    footer{
      border-top:1px solid var(--line);
      background:#080b15;
    }

    .footer-inner{
      width:min(var(--max),calc(100% - 32px));
      margin:auto;
      padding:29px 0;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:20px;
      flex-wrap:wrap;
      color:var(--muted);
      font-size:.66rem;
      line-height:1.65;
    }

    .footer-inner strong{
      color:var(--gold-2);
      font-family:var(--font-brand);
      font-size:.72rem;
      font-weight:600;
      letter-spacing:.1em;
      text-transform:uppercase;
    }

    .empty-state{
      grid-column:1/-1;
      padding:28px;
      border:1px dashed var(--line);
      border-radius:15px;
      text-align:center;
      color:var(--muted);
    }

    @media(max-width:1040px){
      .hero-inner{
        grid-template-columns:1fr;
        text-align:center;
        padding-top:60px;
      }
      .hero-copy{margin:auto}
      .hero-actions{justify-content:center}
      .sound-orbit{min-height:410px}
      .card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .hub-card.featured{grid-column:span 2}
      .planned-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    }

    @media(max-width:760px){
      .topbar-inner{min-height:62px}
      .topnav{
        position:absolute;
        left:16px;
        right:16px;
        top:68px;
        display:none;
        padding:9px;
        border:1px solid var(--line);
        border-radius:12px;
        background:#11172b;
        box-shadow:var(--shadow);
      }
      .topnav.open{display:grid}
      .topnav a{text-align:center}
      .menu-button{display:inline-flex;margin-left:auto}
      .hero-inner{min-height:auto;padding:50px 0 55px}
      .sound-orbit{transform:scale(.86);margin:-30px 0}
      .intro-band{grid-template-columns:1fr}
      .hub-count{width:100%}
      .card-grid{grid-template-columns:1fr}
      .hub-card.featured{grid-column:auto}
      .section-head{display:block}
      .section-head p{margin-top:9px}
    }

    @media(max-width:520px){
      .brand-copy span{display:none}
      h1{font-size:3.55rem}
      .sound-orbit{transform:scale(.72);margin:-58px -70px}
      .directory-tools{align-items:flex-start}
      .search{width:100%}
      .planned-zone{padding:18px}
      .planned-grid{grid-template-columns:1fr}
      .closing{padding:24px 18px}
      .footer-inner{align-items:flex-start;flex-direction:column}
    }

    @media(prefers-reduced-motion:reduce){
      *{scroll-behavior:auto!important;transition:none!important}
    }
  </style>
</head>
<body>
<a class="skip-link" href="#musicDirectory">Skip to the music directory</a>

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="https://vervenveda.github.io/the_refrain.github.io/" aria-label="The Refrain home">
      <span class="brand-mark">TR</span>
      <span class="brand-copy">
        <strong>The Refrain</strong>
        <span>Music & sound across Verve N Veda</span>
      </span>
    </a>

    <button class="menu-button" id="menuButton" type="button" aria-expanded="false" aria-controls="topNavigation">Menu</button>

    <nav class="topnav" id="topNavigation" aria-label="Primary navigation">
      <a href="#create">Create</a>
      <a href="#learn">Learn</a>
      <a href="#share">Share</a>
      <a href="#reflect">Reflect</a>
      <a href="#future">Future Studios</a>
      <a href="https://vervenveda.github.io/proresource_hub.github.io/">ProReSources</a>
      <a href="https://vervenveda.github.io/">Verve N Veda</a>
    </nav>
  </div>
</header>

